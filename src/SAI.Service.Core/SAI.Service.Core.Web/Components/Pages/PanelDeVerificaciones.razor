@page "/panel-de-verificaciones"
@attribute [Authorize]
@using SAI.Service.Core.Application.Acciones
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory FabricaAlcances
@inject IDialogService Dialogos
@inject OpcionesVerificacion OpcionesVerif
@inject OpcionesApagado OpcionesApag

@* Orquestador del panel (rediseño UX): carga las verificaciones, arma la vista con el constructor
   (toda la lógica de estado vive ahí, no en el markup) y compone los componentes de presentación.
   Las acciones destructivas pasan siempre por el diálogo de confirmación (P-5). *@

<PageTitle>Panel de verificaciones — SAI.Service.Core</PageTitle>

<h1 class="mud-typography mud-typography-h4 mb-4">Panel de verificaciones</h1>

@if (_verificaciones is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_verificaciones.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
        Todavía no hay pruebas sembradas. <MudLink Href="/alta-de-equipos" Color="Color.Inherit"><b>Dá de alta un equipo</b></MudLink>.
    </MudAlert>
}
else
{
    <EncabezadoEstadoServicio Modo="_modo" />
    <TiraSecuencia />

    @if (_ocupado)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">Ejecutando la prueba…</MudText>
    }

    @foreach (var vista in _tarjetas)
    {
        <TarjetaVerificacion Vista="vista"
                             Ocupado="_ocupado"
                             OnConfirmarSenal="ConfirmarSenal"
                             OnRegistrarMedicion="RegistrarMedicion"
                             OnDispararApagado="DispararApagado"
                             OnEjecutarCorte="EjecutarCorte"
                             OnReencendido="Reencendido" />
    }

    @if (_mensaje is not null)
    {
        <MudAlert Severity="@_severidad" Variant="Variant.Filled" Class="mt-4">@_mensaje</MudAlert>
    }
}

@code {
    private IReadOnlyList<Verificacion>? _verificaciones;
    private IReadOnlyList<VistaVerificacion> _tarjetas = [];
    private ModoServicioVista _modo = new(ModoServicio.SoloAviso, 0, EvaluadorModalidad.SupuestosRequeridos, false);
    private bool _ocupado;
    private string? _mensaje;
    private Severity _severidad = Severity.Info;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        using var alcance = FabricaAlcances.CreateScope();
        _verificaciones = await alcance.ServiceProvider.GetRequiredService<ServicioVerificacion>()
            .EstadoAsync(CancellationToken.None);

        var constructor = new ConstructorVistaPanel(OpcionesVerif, OpcionesApag);
        (_modo, _tarjetas) = constructor.Construir(_verificaciones, DateTimeOffset.UtcNow);
    }

    // --- Acciones sin riesgo ---
    private Task ConfirmarSenal() => Ejecutar(s => s.VerificarSenalBateriaAsync(CancellationToken.None));

    private Task RegistrarMedicion(int segundos) =>
        Ejecutar(s => s.VerificarPresupuestoAsync(segundos, CancellationToken.None));

    private Task Reencendido(bool arrancoSolo) =>
        Ejecutar(s => s.RegistrarReencendidoAsync(arrancoSolo, CancellationToken.None));

    // --- Acciones destructivas: confirmación deliberada antes de ejecutar (P-5) ---
    private async Task DispararApagado()
    {
        var confirmado = await ConfirmarRiesgo(
            titulo: "Ejecutar prueba de apagado",
            consecuencia: "Esto inicia el apagado ordenado del host: el equipo se va a apagar.",
            precondiciones:
            [
                "Estás en sitio y podés encender el host si no arranca solo.",
                "Nadie está trabajando sobre el host en este momento.",
            ],
            textoConfirmar: "Ejecutar apagado");

        if (confirmado)
        {
            await Ejecutar(s => s.DispararPruebaPresupuestoAsync(CancellationToken.None));
        }
    }

    private async Task EjecutarCorte()
    {
        var confirmado = await ConfirmarRiesgo(
            titulo: "Ejecutar corte con retorno",
            consecuencia: "Esto corta la corriente que alimenta al host.",
            precondiciones:
            [
                "Verificaste el arranque automático en la BIOS del host.",
                "Estás en sitio: si el host no vuelve a encender, hay que hacerlo a mano.",
                "No hay garantía de que el SAI reponga su salida.",
            ],
            textoConfirmar: "Ejecutar corte");

        if (confirmado)
        {
            await Ejecutar(s => s.VerificarCorteConRetornoAsync(CancellationToken.None));
        }
    }

    private async Task<bool> ConfirmarRiesgo(string titulo, string consecuencia, string[] precondiciones, string textoConfirmar)
    {
        var parametros = new DialogParameters<DialogoConfirmacionRiesgo>
        {
            { x => x.Titulo, titulo },
            { x => x.Consecuencia, consecuencia },
            { x => x.Precondiciones, precondiciones },
            { x => x.NombreEquipo, NombreEquipo },
            { x => x.TextoConfirmar, textoConfirmar },
        };
        var opciones = new DialogOptions { CloseOnEscapeKey = true, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialogo = await Dialogos.ShowAsync<DialogoConfirmacionRiesgo>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;
        return resultado is { Canceled: false, Data: bool ok } && ok;
    }

    // El nombre a tipear en la confirmación sale del código de la verificación ("ver-{dispositivo}-{supuesto}").
    private string NombreEquipo
    {
        get
        {
            var codigo = _verificaciones?.FirstOrDefault()?.Codigo;
            if (string.IsNullOrWhiteSpace(codigo))
            {
                return "equipo";
            }

            var partes = codigo.Split('-');
            return partes.Length >= 2 ? partes[1] : codigo;
        }
    }

    private async Task Ejecutar(Func<ServicioVerificacion, Task<ResultadoVerificacion>> accion)
    {
        _ocupado = true;
        try
        {
            using var alcance = FabricaAlcances.CreateScope();
            var resultado = await accion(alcance.ServiceProvider.GetRequiredService<ServicioVerificacion>());
            _mensaje = resultado.Mensaje;
            _severidad = resultado.Codigo switch
            {
                CodigoResultadoVerificacion.Verificado => Severity.Success,
                CodigoResultadoVerificacion.PruebaDisparada => Severity.Info,
                CodigoResultadoVerificacion.Refutado => Severity.Error,
                _ => Severity.Warning,
            };
        }
        finally
        {
            _ocupado = false;
            await Cargar();
        }
    }
}
